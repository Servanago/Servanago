# Required
# Cloudflare API token with Zone:Read and DNS:Edit on your zones.
CLOUDFLARE_API_TOKEN=
# Hostname Caretakarr serves its own UI on. Point its DNS record at this server.
CARETAKARR_HOST=caretakarr.example.com
# Let's Encrypt account contact. A bare address, not "Name <addr>".
ACME_EMAIL=you@example.com

# Strongly recommended: without it the UI is open to anyone who can reach it.
ADMIN_PASSWORD=

# Optional
# ACME_STAGING=true
# DNS-01 tuning (unset = Caddy defaults; 2m / 10m work on slow homelab DNS)
# ACME_PROPAGATION_DELAY=2m
# ACME_PROPAGATION_TIMEOUT=10m
# ACME_RESOLVERS=1.1.1.1,8.8.8.8
# UI_LISTEN=127.0.0.1:8080
# DOCKER_SOCKET=/var/run/docker.sock
