# Required
# Hostname ServanaGo serves its own UI on. Point its DNS record at this server.
SERVANAGO_HOST=servanago.example.com
# Let's Encrypt account contact. A bare address, not "Name <addr>".
ACME_EMAIL=you@example.com

# Cloudflare (optional). Leave CLOUDFLARE_API_TOKEN empty to run without it: certificates use
# HTTP-01/TLS-ALPN (ports 80 and 443 must be reachable from the internet), no DNS records are
# managed, and each domain is added by hand on the Domains page.
# With a token (Zone:Read and DNS:Edit on your zones) ServanaGo also gets wildcard certificates
# via DNS-01 and creates the A records, and SERVANAGO_HOST_IP becomes required.
CLOUDFLARE_API_TOKEN=
# The address SERVANAGO_HOST resolves to; ServanaGo creates that A record. Any usable IPv4:
# public, private (10/8, 172.16/12, 192.168/16) or 100.64/10 (Tailscale). Same rule for every domain and route IP.
SERVANAGO_HOST_IP=192.168.1.10
# Optional IPv6 address of SERVANAGO_HOST: ServanaGo also manages an AAAA record for it.
# The IPv4 address above stays required. Public or unique-local (fd00::/8) addresses only.
# SERVANAGO_HOST_IP6=

# Strongly recommended: without it the UI is open to anyone who can reach it.
ADMIN_PASSWORD=

# Optional
# Enables the authenticator app (seed stored encrypted). At least 32 chars: openssl rand -hex 32
# SERVANAGO_SECRET_KEY=
# Force an authenticator code after the password (needs ADMIN_PASSWORD and SERVANAGO_SECRET_KEY).
# REQUIRE_2FA=true
# Cloudflare Turnstile on the password form (both or neither).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# Cloudflare zone holding SERVANAGO_HOST; unset = closest enclosing zone the token can see.
# SERVANAGO_HOST_ZONE=example.com
# ACME_STAGING=true
# DNS-01 tuning. Caddy's default (no delay, 2m timeout) can give up before Cloudflare serves the
# challenge TXT record ("timed out waiting for record to fully propagate"); 2m / 10m fixed that.
ACME_PROPAGATION_DELAY=2m
ACME_PROPAGATION_TIMEOUT=10m
# ACME_RESOLVERS=1.1.1.1,8.8.8.8
# UI_LISTEN=127.0.0.1:8080
