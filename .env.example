# Required
# Cloudflare API token with Zone:Read and DNS:Edit on your zones.
CLOUDFLARE_API_TOKEN=
# Hostname Caretakarr serves its own UI on. Point its DNS record at this server.
CARETAKARR_HOST=caretakarr.example.com
# The address CARETAKARR_HOST resolves to; Caretakarr creates that A record. Private IPv4 only
# (10/8, 172.16/12, 192.168/16, or 100.64/10 for Tailscale). Same rule for every domain and route IP.
CARETAKARR_HOST_IP=192.168.1.10
# Let's Encrypt account contact. A bare address, not "Name <addr>".
ACME_EMAIL=you@example.com

# Strongly recommended: without it the UI is open to anyone who can reach it.
ADMIN_PASSWORD=

# Optional
# Cloudflare zone holding CARETAKARR_HOST; unset = closest enclosing zone the token can see.
# CARETAKARR_HOST_ZONE=example.com
# ACME_STAGING=true
# DNS-01 tuning. Caddy's default (no delay, 2m timeout) can give up before Cloudflare serves the
# challenge TXT record ("timed out waiting for record to fully propagate"); 2m / 10m fixed that.
ACME_PROPAGATION_DELAY=2m
ACME_PROPAGATION_TIMEOUT=10m
# ACME_RESOLVERS=1.1.1.1,8.8.8.8
# UI_LISTEN=127.0.0.1:8080
# DOCKER_SOCKET=/var/run/docker.sock
