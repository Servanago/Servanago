{
  "admin": {
    "config": {
      "persist": false
    },
    "disabled": true
  },
  "apps": {
    "http": {
      "http_port": 80,
      "https_port": 443,
      "servers": {
        "srv0": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:8080"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "servanago.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "servanago_gate",
                          "host": "sonarr.example.com",
                          "mode": "acl",
                          "site_id": 1
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "authentication",
                          "providers": {
                            "http_basic": {
                              "accounts": [
                                {
                                  "password": "$2a$14$abc",
                                  "username": "u"
                                }
                              ],
                              "hash": {
                                "algorithm": "bcrypt"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "encodings": {
                                    "gzip": {},
                                    "zstd": {}
                                  },
                                  "handler": "encode",
                                  "prefer": [
                                    "gzip",
                                    "zstd"
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "not": [
                            {
                              "path": [
                                "/.well-known/*"
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "static_response",
                                  "status_code": "404"
                                }
                              ],
                              "match": [
                                {
                                  "path_regexp": {
                                    "pattern": "(^|/)\\."
                                  }
                                }
                              ],
                              "terminal": true
                            },
                            {
                              "handle": [
                                {
                                  "handler": "file_server",
                                  "root": "/srv/www/blog"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "sonarr.example.com"
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "challenges": {
                  "dns": {
                    "provider": {
                      "api_token": "{env.CLOUDFLARE_API_TOKEN}",
                      "name": "cloudflare"
                    },
                    "resolvers": [
                      "1.1.1.1",
                      "8.8.8.8"
                    ]
                  }
                },
                "email": "me@example.com",
                "module": "acme"
              }
            ],
            "subjects": [
              "servanago.example.com"
            ]
          },
          {
            "issuers": [
              {
                "challenges": {
                  "dns": {
                    "provider": {
                      "api_token": "{env.CLOUDFLARE_API_TOKEN}",
                      "name": "cloudflare"
                    },
                    "resolvers": [
                      "1.1.1.1",
                      "8.8.8.8"
                    ]
                  }
                },
                "email": "me@example.com",
                "module": "acme"
              }
            ],
            "subjects": [
              "*.example.com"
            ]
          }
        ]
      }
    }
  },
  "logging": {
    "logs": {
      "default": {
        "encoder": {
          "format": "json"
        },
        "level": "INFO",
        "writer": {
          "output": "servanago"
        }
      }
    }
  },
  "storage": {
    "module": "file_system",
    "root": "/data/caddy"
  }
}
