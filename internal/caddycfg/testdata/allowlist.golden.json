{
  "admin": {
    "config": {
      "persist": false
    },
    "disabled": true
  },
  "apps": {
    "http": {
      "http_port": 80,
      "https_port": 443,
      "servers": {
        "srv0": {
          "client_ip_headers": [
            "CF-Connecting-IP"
          ],
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:8080"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "servanago.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "allow": [
                            "192.168.0.0/16",
                            "10.0.0.0/8"
                          ],
                          "handler": "servanago_traffic",
                          "site": ""
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "vars",
                          "sg_outcome": "blocked"
                        },
                        {
                          "handler": "static_response",
                          "status_code": "403"
                        }
                      ],
                      "match": [
                        {
                          "not": [
                            {
                              "client_ip": {
                                "ranges": [
                                  "192.168.0.0/16",
                                  "10.0.0.0/8"
                                ]
                              }
                            }
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "192.168.1.20:8989"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "sonarr.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "servanago_traffic",
                  "site": "",
                  "unknown": true
                },
                {
                  "handler": "servanago_ban"
                },
                {
                  "handler": "static_response",
                  "status_code": "404"
                }
              ],
              "terminal": true
            }
          ],
          "trusted_proxies": {
            "ranges": [
              "173.245.48.0/20",
              "103.21.244.0/22",
              "103.22.200.0/22",
              "103.31.4.0/22",
              "141.101.64.0/18",
              "108.162.192.0/18",
              "190.93.240.0/20",
              "188.114.96.0/20",
              "197.234.240.0/22",
              "198.41.128.0/17",
              "162.158.0.0/15",
              "104.16.0.0/13",
              "104.24.0.0/14",
              "172.64.0.0/13",
              "131.0.72.0/22",
              "2400:cb00::/32",
              "2606:4700::/32",
              "2803:f800::/32",
              "2405:b500::/32",
              "2405:8100::/32",
              "2a06:98c0::/29",
              "2c0f:f248::/32"
            ],
            "source": "static"
          }
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "challenges": {
                  "dns": {
                    "provider": {
                      "api_token": "{env.CLOUDFLARE_API_TOKEN}",
                      "name": "cloudflare"
                    },
                    "resolvers": [
                      "1.1.1.1",
                      "8.8.8.8"
                    ]
                  }
                },
                "email": "me@example.com",
                "module": "acme"
              }
            ],
            "subjects": [
              "servanago.example.com"
            ]
          },
          {
            "issuers": [
              {
                "challenges": {
                  "dns": {
                    "provider": {
                      "api_token": "{env.CLOUDFLARE_API_TOKEN}",
                      "name": "cloudflare"
                    },
                    "resolvers": [
                      "1.1.1.1",
                      "8.8.8.8"
                    ]
                  }
                },
                "email": "me@example.com",
                "module": "acme"
              }
            ],
            "subjects": [
              "*.example.com"
            ]
          }
        ]
      }
    }
  },
  "logging": {
    "logs": {
      "default": {
        "encoder": {
          "format": "json"
        },
        "level": "INFO",
        "writer": {
          "output": "servanago"
        }
      }
    }
  },
  "storage": {
    "module": "file_system",
    "root": "/data/caddy"
  }
}
