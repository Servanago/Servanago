[Unit]
Description=ServanaGo web runtime manager (UI and embedded Caddy ingress)
After=network-online.target
Wants=network-online.target

[Service]
User=servanago
Group=servanago
ExecStart=/usr/bin/servanago
EnvironmentFile=-/etc/servanago/servanago.env
# The UI never runs as root; 80/443 come from the bind capability alone.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Everything ServanaGo writes lives in the data dir; the rest of the file system is read-only to it.
ProtectSystem=strict
ReadWritePaths=/var/lib/servanago /var/log/servanago
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027
# Static site roots may live under /home (existing public_html): the protect-home option stays unset.
Restart=on-failure

[Install]
WantedBy=multi-user.target